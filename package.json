{
  "name": "@gabriel-sisjr/react-native-sync-provider",
  "version": "0.1.0",
  "description": "Provider to Sync",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.11.0"
  },
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./lib/module/index.js",
      "browser": "./lib/module/index.web.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-sync-provider-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "docs:dev": "yarn workspace react-native-sync-provider-website start",
    "docs:build": "yarn workspace react-native-sync-provider-website build",
    "docs:serve": "yarn workspace react-native-sync-provider-website serve",
    "docs:clear": "yarn workspace react-native-sync-provider-website clear"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "nitro",
    "nitro-module",
    "sync",
    "synchronization",
    "offline",
    "offline-first",
    "queue",
    "background-sync",
    "mmkv",
    "netinfo",
    "connectivity",
    "retry",
    "kotlin",
    "swift",
    "typescript",
    "hybrid-object",
    "persistence",
    "network",
    "reactive",
    "hooks",
    "new-architecture",
    "fabric",
    "mobile",
    "cross-platform",
    "http",
    "workmanager",
    "bgtaskscheduler",
    "coredata",
    "room"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabriel-sisjr/react-native-sync-provider.git"
  },
  "author": "Gabriel Santana <gabriel.sistemasjr@gmail.com> (https://github.com/gabriel-sisjr)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gabriel-sisjr/react-native-sync-provider/issues"
  },
  "homepage": "https://github.com/gabriel-sisjr/react-native-sync-provider#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/uuid": "^10.0.0",
    "commitlint": "^20.5.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "lefthook": "^2.1.4",
    "nitrogen": "^0.35.6",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-test-renderer": "19.2.3",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": ">=11.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0",
    "react-native-mmkv": ">=3.0.0",
    "react-native-nitro-modules": "^0.35.6"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "react-native-mmkv": {
      "optional": true
    }
  },
  "workspaces": [
    "example",
    "website"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup-minimal.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.{js,ts,tsx}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts,tsx}",
      "!src/__tests__/**",
      "!src/**/*.d.ts",
      "!src/SyncProvider.nitro.ts"
    ],
    "coverageReporters": [
      "json-summary",
      "lcov",
      "text"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest",
      "lefthook"
    ],
    "version": "0.62.0"
  }
}
