{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "test": {
      "env": ["NODE_ENV", "CI"],
      "inputs": [
        "package.json",
        "yarn.lock",
        "tsconfig.json",
        "src/**",
        "!src/**/__snapshots__/**"
      ],
      "outputs": ["coverage/**"]
    },
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "yarn.lock",
        "nitro.json",
        "android",
        "!android/build",
        "!android/.gradle",
        "!android/.cxx",
        "src/*.ts",
        "src/*.tsx",
        "src/**/*.nitro.ts",
        "example/package.json",
        "example/android",
        "!example/android/.gradle",
        "!example/android/build",
        "!example/android/app/build",
        "!example/android/app/.cxx"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "yarn.lock",
        "nitro.json",
        "*.podspec",
        "ios",
        "src/*.ts",
        "src/*.tsx",
        "src/**/*.nitro.ts",
        "example/package.json",
        "example/ios",
        "!example/ios/build",
        "!example/ios/Pods",
        "!example/ios/**/*.xcuserstate",
        "!example/ios/**/xcuserdata"
      ],
      "outputs": []
    }
  }
}
