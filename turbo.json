{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "android/**",
        "!android/.gradle/**",
        "!android/.kotlin/**",
        "!android/build/**",
        "!android/local.properties",
        "!android/app/build/**",
        "!android/app/.cxx/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/nitro.json",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/.gradle/**",
        "!$TURBO_ROOT$/android/.kotlin/**",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/android/.cxx/**",
        "$TURBO_ROOT$/src/*.ts",
        "$TURBO_ROOT$/src/*.tsx",
        "$TURBO_ROOT$/src/**/*.nitro.ts"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**",
        "!ios/.xcode.env.local",
        "!ios/**/*.xcuserstate",
        "!ios/**/xcuserdata/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/nitro.json",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/src/*.ts",
        "$TURBO_ROOT$/src/*.tsx",
        "$TURBO_ROOT$/src/**/*.nitro.ts"
      ],
      "outputs": []
    }
  }
}
